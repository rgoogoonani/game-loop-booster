<Application x:Class="GameLoopBooster.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameLoopBooster.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EqualsToVisibilityConverter x:Key="EqVis" />
            <conv:EqualsToBoolConverter x:Key="EqBool" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
            <conv:CheckStateToBrushConverter x:Key="StateBrush" />
            <conv:InverseBoolConverter x:Key="InvBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
