<UserControl x:Class="GameLoopBooster.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <DockPanel Margin="28,8,28,0">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="بهینه‌سازی‌ها" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="هر مورد را می‌توانید روشن/خاموش کنید. در حالت پیشرفته مسیر دقیق، مقدار فعلی، مقدار اولیه و مقدار دلخواه نمایش داده می‌شود." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AdvancedMode}" Margin="0,0,18,0">
                    <TextBlock Text="حالت پیشرفته" FontWeight="SemiBold" />
                </CheckBox>
                <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="خواندن دوباره مقادیر فعلی">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding BoostCommand}">
                    <TextBlock Foreground="#06121A" FontWeight="Bold">
                        <Run Text="اعمال " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" مورد انتخاب‌شده" />
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
            <ItemsControl ItemsSource="{Binding TweaksView}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,18,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource AccentGradient}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#4000E5FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                    <StackPanel Grid.Column="1">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" />
                                            <Border CornerRadius="6" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Safe">
                                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Aggressive">
                                                                <Setter Property="Background" Value="{StaticResource Accent2SoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Expert">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LevelText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border CornerRadius="6" Padding="7,1" Background="{StaticResource Surface3Brush}" VerticalAlignment="Center"
                                                    Visibility="{Binding RequiresReboot, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="نیاز به ری‌استارت" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="18,0,0,0" MinWidth="150" HorizontalAlignment="Right">
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="اعمال نشده" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                <Setter Property="Text" Value="✓ فعال" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Current}" Style="{StaticResource Label}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                   FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding Current}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Advanced editor -->
                                <Border Margin="0,14,0,0" Padding="14" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                        Visibility="{Binding DataContext.AdvancedMode, ElementName=Self, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Location}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                                        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="0,10,0,10">
                                            <StackPanel>
                                                <TextBlock Text="مقدار فعلی" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding Current}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="مقدار اولیه (بکاپ)" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding Original}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="پیشنهادی" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding Recommended}" Style="{StaticResource Mono}" HorizontalAlignment="Right" Margin="0,3,0,0" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="مقدار دلخواه:" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,10,0" />
                                            <TextBox Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" Width="230" FlowDirection="LeftToRight" />
                                            <TextBlock Text="{Binding ValueHint}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallButton}" Content="پیشنهادی" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ResetValueCommand, ElementName=Self}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SmallButton}" Content="بازگردانی" Margin="0,0,6,0"
                                                    IsEnabled="{Binding HasBackup}"
                                                    Command="{Binding DataContext.RestoreOneCommand, ElementName=Self}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SmallButton}" Content="اعمال" Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}"
                                                    Command="{Binding DataContext.ApplyOneCommand, ElementName=Self}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
